# Postgres - point this at your own local or hosted instance
DATABASE_URL="postgresql://wardly:wardly@localhost:5432/wardly?schema=public"

# JWT secrets - change these in any real deployment
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# File storage (signed URL HMAC secret)
FILE_URL_SECRET="dev-file-secret-change-me"
STORAGE_ROOT="./storage"

# Cloudflare R2 (S3-compatible object storage) - leave all four unset to use local-filesystem
# storage in dev. Set all four to switch to R2 (required for serverless/production hosting,
# where local disk isn't persistent). Create a bucket + API token at dash.cloudflare.com/?to=/:account/r2.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""

# Email (Resend) - leave unset to log emails to the console in dev. Set RESEND_API_KEY to send
# real emails in production (https://resend.com/api-keys). EMAIL_FROM must be either Resend's
# shared sandbox address below (no domain verification needed, but only reaches your own
# Resend account email) or an address on a domain you've verified with Resend.
RESEND_API_KEY=""
EMAIL_FROM="Wardly <onboarding@resend.dev>"

# App
APP_BASE_URL="http://localhost:3000"

# Dev-only convenience: shows quick-switch buttons in the nav for the three seeded demo
# accounts (prisma/seed.ts). Never enable this in a real deployment. Leave unset/false normally.
NEXT_PUBLIC_SKIP_AUTH="false"
